{
  "manifest_version": 3,
  "name": "YouTube Ad Skip",
  "version": "0.2.0",
  "description": "Bloque les publicités YouTube avant leur affichage et clique sur « Ignorer » pour celles qui passent quand même.",
  "permissions": ["debugger", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "YouTube Ad Skip",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "common/settings.js",
        "content/detector.js",
        "content/ad-skipper.js",
        "content/ad-accelerator.js",
        "content/observer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
